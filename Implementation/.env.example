# Copy this file to `.env` (in the Implementation/ folder) and fill in your own keys.
# `.env` is git-ignored. Never commit real keys.

# --- OpenRouter (used by phases 5, 6, 7 and the ablation scripts) -------------------------
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: several keys, comma-separated, used round-robin to spread rate limits.
# If set, this takes precedence over OPENROUTER_API_KEY.
# OPENROUTER_API_KEYS=key-one,key-two,key-three

# --- Optional model overrides (defaults match the paper) ------------------------------------
# Text LLM: query decomposition and answer generation
# VRAG_LLM_MODEL=meta-llama/llama-3.1-8b-instruct
# Vision-language model: keyframe captioning
# VRAG_VLM_MODEL=qwen/qwen2.5-vl-72b-instruct
# Phase 7: model that writes the QA pairs, and the LLM judge (paper: Gemma-4-31B-IT)
# VRAG_QA_MODEL=meta-llama/llama-3.1-8b-instruct
# VRAG_JUDGE_MODEL=google/gemma-4-31b-it
