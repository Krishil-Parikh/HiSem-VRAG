# Ignore everything at the repository root by default
*

# Keep this file tracked
!.gitignore

# Allow only the project folders and top-level docs (and all their contents)
!backend/
!backend/**
!frontend/
!frontend/**
!Implementation/
!Implementation/**
!docs/
!docs/**
!README.md
!LICENSE
!CITATION.cff

# Python virtual environments and caches inside backend
backend/venv/
backend/.venv/
backend/env/
backend/.env/
backend/__pycache__/
backend/**/*.py[cod]

# Node/Next build artifacts and dependencies inside frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/

# Logs and local env files inside allowed directories
backend/*.log
frontend/*.log
backend/.env.local
backend/.env.*.local
frontend/.env.local
frontend/.env.*.local

# Secrets: never commit real env files. These come last so they override the re-includes above.
.env
**/.env
**/.env.*
!**/.env.example
