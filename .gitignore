# Ignore everything at the repository root by default
*

# Keep this file tracked
!.gitignore

# Allow only backend and frontend directories (and all their contents)
!backend/
!backend/**
!frontend/
!frontend/**

# Python virtual environments and caches inside backend
backend/venv/
backend/.venv/
backend/env/
backend/.env/
backend/__pycache__/
backend/**/*.py[cod]

# Node/Next build artifacts and dependencies inside frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/

# Logs and local env files inside allowed directories
backend/*.log
frontend/*.log
backend/.env.local
backend/.env.*.local
frontend/.env.local
frontend/.env.*.local
